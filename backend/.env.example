# Copy to .env and fill in. Never commit .env.
ENV=development
DATABASE_URL=sqlite:///./roktodoot.db
# Supabase Postgres example:
# DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
CORS_ORIGINS=http://localhost:3000
APP_SECRET=replace-with-a-long-random-string

# Auth
DEV_LOGIN_ENABLED=true
SUPABASE_URL=
SUPABASE_JWT_SECRET=
ADMIN_EMAILS=admin@demo.roktodoot.org

# Intake agent (optional; the rule-based parser is used without it)
GEMINI_API_KEY=

# Email (optional; logged to the console without it)
RESEND_API_KEY=

# 60 = real time. 3 = demo speed (a 10-minute wave lasts 30 seconds).
SECONDS_PER_MINUTE=60
